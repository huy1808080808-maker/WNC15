@model ErrorViewModel
@{
    ViewData["Title"] = "Đã xảy ra sự cố";
}

<div class="row justify-content-center py-5">
    <div class="col-md-8 col-lg-6 text-center">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
            <div class="mb-4">
                <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-inline-flex p-4">
                    <i class="bi bi-exclamation-triangle-fill display-4"></i>
                </div>
            </div>

            <h3 class="fw-bold text-dark mb-2">Đã xảy ra sự cố trong quá trình xử lý</h3>
            <p class="text-muted mb-4">
                Hệ thống gặp lỗi không mong muốn khi thực hiện yêu cầu của bạn. Quá trình này đã được ghi nhận vào nhật ký hệ thống.
            </p>

            @if (Model != null && Model.ShowRequestId)
            {
                <div class="alert alert-light border small text-muted mb-4 py-2">
                    <span class="fw-semibold">Mã yêu cầu (Request ID):</span> 
                    <code>@Model.RequestId</code>
                </div>
            }

            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2 fw-semibold shadow-sm">
                    <i class="bi bi-house-door me-1"></i> Quay lại Trang chủ
                </a>
                <button type="button" class="btn btn-outline-secondary px-4 py-2 fw-semibold" onclick="window.location.reload();">
                    <i class="bi bi-arrow-clockwise me-1"></i> Tải lại trang
                </button>
            </div>
        </div>
    </div>
</div>
