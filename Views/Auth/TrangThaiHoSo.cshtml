
@{
    ViewData["Title"] = "Trạng thái hồ sơ Hội viên";
    var status = (ViewBag.Status as string) ?? "cho_duyet";
    var reason = ViewBag.Reason as string;
    var email = ViewBag.Email as string ?? "Hội viên";
}

<div class="row justify-content-center py-5">
    <div class="col-lg-6 col-md-8">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            @if (status == "cho_duyet")
            {
                <div class="card-header bg-warning bg-opacity-25 border-bottom border-warning border-opacity-25 py-4 text-center">
                    <div class="bg-warning text-dark rounded-circle d-inline-flex p-3 mb-2 shadow-sm">
                        <i class="bi bi-hourglass-split fs-2"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-0">Hồ Sơ Đang Chờ Xét Duyệt</h4>
                    <span class="badge bg-warning text-dark mt-2 px-3 py-2">Trạng thái: Đang chờ xét duyệt</span>
                </div>
                <div class="card-body p-4 p-md-5 text-center">
                    <p class="text-secondary mb-3">
                        Kính gửi bạn <strong>@email</strong>,<br>
                        Hồ sơ đăng ký gia nhập Hiệp hội của bạn đã được ghi nhận trên hệ thống và đang trong quá trình được <strong>Ban Thư ký & Ban Quản Trị</strong> thẩm định thông tin.
                    </p>
                    <div class="alert alert-light border small text-start mb-4">
                        <i class="bi bi-info-circle text-primary me-2"></i>
                        Thời gian xét duyệt thông thường từ <strong>1 - 3 ngày làm việc</strong>. Sau khi được duyệt, bạn sẽ nhận được thông báo kích hoạt tài khoản và có thể đăng nhập đầy đủ các chức năng.
                    </div>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2">
                        <i class="bi bi-house me-1"></i> Quay lại Trang chủ
                    </a>
                </div>
            }
            else if (status == "tu_choi")
            {
                <div class="card-header bg-danger bg-opacity-10 border-bottom border-danger border-opacity-25 py-4 text-center">
                    <div class="bg-danger text-white rounded-circle d-inline-flex p-3 mb-2 shadow-sm">
                        <i class="bi bi-x-circle-fill fs-2"></i>
                    </div>
                    <h4 class="fw-bold text-danger mb-0">Hồ Sơ Không Được Phê Duyệt</h4>
                    <span class="badge bg-danger mt-2 px-3 py-2">Trạng thái: Từ chối hồ sơ</span>
                </div>
                <div class="card-body p-4 p-md-5 text-center">
                    <p class="text-secondary mb-3">
                        Rất tiếc, hồ sơ đăng ký gia nhập Hiệp hội của bạn chưa đủ điều kiện để kích hoạt tài khoản.
                    </p>
                    @if (!string.IsNullOrEmpty(reason))
                    {
                        <div class="alert alert-danger text-start small mb-4">
                            <strong>Lý do từ chối từ Ban Quản Trị:</strong>
                            <p class="mb-0 mt-1">@reason</p>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-secondary text-start small mb-4">
                            Thông tin kê khai chưa đầy đủ hoặc không phù hợp với tiêu chí hội viên chuyên môn của Hiệp hội.
                        </div>
                    }
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-controller="Auth" asp-action="DangKy" class="btn btn-outline-primary px-3 py-2">
                            <i class="bi bi-pencil-square me-1"></i> Nộp lại đơn đăng ký
                        </a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary px-3 py-2">
                            <i class="bi bi-house me-1"></i> Trang chủ
                        </a>
                    </div>
                </div>
            }
            else if (status == "khoa")
            {
                <div class="card-header bg-secondary bg-opacity-10 border-bottom py-4 text-center">
                    <div class="bg-secondary text-white rounded-circle d-inline-flex p-3 mb-2 shadow-sm">
                        <i class="bi bi-lock-fill fs-2"></i>
                    </div>
                    <h4 class="fw-bold text-secondary mb-0">Tài Khoản Đang Bị Tạm Khóa</h4>
                    <span class="badge bg-secondary mt-2 px-3 py-2">Trạng thái: Tạm khóa</span>
                </div>
                <div class="card-body p-4 p-md-5 text-center">
                    <p class="text-secondary mb-4">
                        Tài khoản hội viên này hiện đang bị tạm dừng quyền truy cập do vi phạm quy chế hoặc theo yêu cầu của Quản trị viên.
                    </p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2">
                        <i class="bi bi-house me-1"></i> Quay về Trang chủ
                    </a>
                </div>
            }
        </div>
    </div>
</div>
