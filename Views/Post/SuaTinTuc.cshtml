@model WNC15.Models.BaiViet
@{
    ViewData["Title"] = "Chỉnh sửa bài viết";
}

<div class="row justify-content-center py-3">
    <div class="col-lg-9 col-md-11">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"
                        class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-controller="AdminMember" asp-action="BangQuanTri"
                        class="text-decoration-none">Quản trị</a></li>
                <li class="breadcrumb-item"><a asp-controller="Post" asp-action="DanhSachTinTuc"
                        class="text-decoration-none">Tin tức</a></li>
                <li class="breadcrumb-item active" aria-current="page">Chỉnh sửa</li>
            </ol>
        </nav>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-bottom py-3 px-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h4 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-pencil-square text-warning me-2"></i>Chỉnh Sửa Bài Viết
                        </h4>
                        <small class="text-muted">Cập nhật nội dung, chuyên mục và trạng thái kiểm duyệt bài
                            viết</small>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                <!-- Hiển thị lỗi tổng quát nếu có -->
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3" role="alert"></div>

                <form asp-controller="Post" asp-action="SuaTinTuc" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.MaBaiViet" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Tiêu đề bài viết <span
                                class="text-danger">*</span></label>
                        <input type="text" name="title" class="form-control" value="@Model.TieuDe" required />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">Chuyên mục tin tức <span
                                    class="text-danger">*</span></label>
                            <select name="categoryId" class="form-select" required>
                                @{
                                    var dsDanhMuc = ViewBag.DanhMucs as IEnumerable<WNC15.Models.DanhMuc> ?? new List<WNC15.Models.DanhMuc>();
                                    foreach (var dm in dsDanhMuc)
                                    {
                                        <option value="@dm.MaDanhMuc" selected="@(Model.MaDanhMuc == dm.MaDanhMuc)">@dm.TenDanhMuc</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">Trạng thái xuất bản</label>
                            <select name="status" class="form-select">
                                <option value="da_dang" selected="@(Model.TrangThai == "da_dang")">Đã xuất bản (Công khai)</option>
                                <option value="an" selected="@(Model.TrangThai == "an")">Đang ẩn (Tạm khóa hiển thị)</option>
                                <option value="cho_duyet" selected="@(Model.TrangThai == "cho_duyet")">Chờ duyệt</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Ảnh đại diện bài viết</label>
                        <input type="file" name="thumbnail" id="inputThumbnail" class="form-control" accept="image/*" />
                        <div class="mt-2 d-flex align-items-center gap-3">
                            @{
                                var hinhAnh = "https://placehold.co/160x100?text=Chua+Co+Anh";
                                if (!string.IsNullOrEmpty(Model.AnhDaiDien))
                                {
                                    hinhAnh = Model.AnhDaiDien;
                                }
                            }
                            <img id="imgPreview" 
                                 src="@hinhAnh" 
                                 alt="Ảnh xem trước" 
                                 class="rounded-3 border shadow-sm" 
                                 style="width: 160px; height: 100px; object-fit: cover;" 
                                 onerror="this.src='https://placehold.co/160x100?text=Chua+Co+Anh';" />
                            <small class="text-muted">Chọn ảnh mới từ máy tính để thay đổi ảnh đại diện bài viết.</small>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Tóm tắt ngắn gọn</label>
                        <textarea name="summary" rows="2" class="form-control"
                            placeholder="Tóm tắt 1-2 câu ngắn mô tả nội dung chính...">@Model.TomTat</textarea>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold text-secondary small">Nội dung chi tiết bài viết <span
                                class="text-danger">*</span></label>
                        <textarea name="content" rows="10" class="form-control"
                            placeholder="Toàn văn nội dung bài viết..." required>@Model.NoiDung</textarea>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <a asp-controller="AdminMember" asp-action="BangQuanTri" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại Dashboard
                        </a>
                        <div class="d-flex gap-2">
                            <a asp-controller="Post" asp-action="ChiTiet" asp-route-id="@Model.MaBaiViet"
                                class="btn btn-outline-info" target="_blank">
                                <i class="bi bi-eye me-1"></i> Xem trước
                            </a>
                            <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                                <i class="bi bi-check-lg me-1"></i> Lưu thay đổi
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var inputThumbnail = document.getElementById('inputThumbnail');
        if (inputThumbnail) {
            inputThumbnail.addEventListener('change', function (e) {
                if (e.target.files && e.target.files.length > 0) {
                    var file = e.target.files[0];
                    var imgPreview = document.getElementById('imgPreview');
                    if (imgPreview) {
                        imgPreview.src = URL.createObjectURL(file);
                    }
                }
            });
        }
    </script>
}
