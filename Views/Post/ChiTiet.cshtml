@model WNC15.Models.BaiViet
@{
    ViewData["Title"] = Model != null ? Model.TieuDe : "Chi tiết bài viết";
    var tieuDe = Model != null ? Model.TieuDe : "Xu hướng ứng dụng Trí tuệ nhân tạo trong chuyển đổi số";
    var tenDanhMuc = Model != null && Model.DanhMuc != null ? Model.DanhMuc.TenDanhMuc : "Nghiên cứu & Công nghệ";
    var tenTacGia = Model != null && Model.TacGia != null ? Model.TacGia.HoTen : "Ban Thư Ký Hiệp Hội";
    var ngayDang = Model != null ? Model.NgayTao.ToString("dd/MM/yyyy HH:mm") : "22/10/2026";
    var luotXem = Model != null ? Model.LuotXem : 125;
    var tomTat = Model != null ? Model.TomTat : "";
    var noiDung = Model != null ? Model.NoiDung : "";
}

<div class="row justify-content-center py-3">
    <div class="col-lg-9 col-md-11">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-controller="Post" asp-action="DanhSachTinTuc" class="text-decoration-none">Tin tức</a></li>
                <li class="breadcrumb-item active" aria-current="page">Nội dung chi tiết</li>
            </ol>
        </nav>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
            <div class="card-body p-4 p-md-5">
                <div class="mb-3">
                    <span class="badge bg-primary px-3 py-2 rounded-pill">@tenDanhMuc</span>
                </div>

                <h2 class="fw-bold text-dark mb-3">
                    @tieuDe
                </h2>

                <div class="d-flex flex-wrap align-items-center text-muted small pb-3 mb-4 border-bottom gap-3">
                    <div><i class="bi bi-person-fill text-primary me-1"></i>Tác giả: <strong>@tenTacGia</strong></div>
                    <div><i class="bi bi-calendar3 text-primary me-1"></i>Ngày đăng: @ngayDang</div>
                    <div><i class="bi bi-eye-fill text-primary me-1"></i>Lượt xem: @luotXem</div>
                </div>

                <!-- Tóm tắt bài viết -->
                @if (!string.IsNullOrEmpty(tomTat))
                {
                    <div class="p-3 bg-light rounded-3 border-start border-primary border-4 mb-4">
                        <p class="fst-italic text-secondary mb-0">
                            @tomTat
                        </p>
                    </div>
                }

                <!-- Nội dung chi tiết -->
                <div class="article-content text-secondary lh-lg mb-4" style="white-space: pre-line; font-size: 1.05rem;">
                    @noiDung
                </div>

                <div class="pt-4 border-top d-flex justify-content-between align-items-center">
                    <a asp-controller="Post" asp-action="DanhSachTinTuc" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách tin tức
                    </a>
                    <div class="d-flex gap-2">
                        @if (Model != null && User.IsInRole("quan_tri"))
                        {
                            <form asp-controller="Post" asp-action="XoaTinTuc" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.MaBaiViet" />
                                <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Bạn có chắc chắn muốn xóa bài viết này không?');">
                                    <i class="bi bi-trash me-1"></i> Xóa bài
                                </button>
                            </form>
                        }
                        <button class="btn btn-outline-primary" onclick="window.print()">
                            <i class="bi bi-printer me-1"></i> In bài viết
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
