@model IEnumerable<WNC15.Models.BaiViet>
@{
    ViewData["Title"] = "Tin tức & Hoạt động chuyên môn";
    var tuKhoa = ViewBag.Search as string ?? "";
    var maDanhMuc = ViewBag.CategoryId != null ? (int)ViewBag.CategoryId : 0;
}

<div class="py-3">
    <!-- Tiêu đề trang & Nút Đăng bài cho Quản trị viên -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-newspaper text-primary me-2"></i>Tin Tức & Hoạt Động
            </h2>
            <p class="text-muted small mb-0">Cập nhật các công trình nghiên cứu, thông báo và hoạt động học thuật mới nhất</p>
        </div>
        @if (User.IsInRole("Admin") || User.IsInRole("quan_tri"))
        {
            <div>
                <a asp-controller="Post" asp-action="ThemTinTuc" class="btn btn-primary fw-semibold shadow-sm">
                    <i class="bi bi-pencil-square me-1"></i> Đăng bài viết mới
                </a>
            </div>
        }
    </div>

    <!-- Thanh tìm kiếm và bộ lọc chuyên mục -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
        <form asp-controller="Post" asp-action="DanhSachTinTuc" method="get">
            <div class="row g-2 align-items-center">
                <div class="col-md-7">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" value="@tuKhoa" class="form-control bg-light border-start-0" placeholder="Nhập từ khóa tìm kiếm bài viết..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select bg-light" name="categoryId">
                        <option value="0">Tất cả chuyên mục</option>
                        <option value="1" selected="@(maDanhMuc == 1)">Nghiên cứu & Công nghệ</option>
                        <option value="2" selected="@(maDanhMuc == 2)">Thông báo Hiệp hội</option>
                        <option value="3" selected="@(maDanhMuc == 3)">Sinh hoạt Hội viên</option>
                    </select>
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-outline-primary fw-semibold">
                        <i class="bi bi-funnel me-1"></i> Tìm kiếm
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Danh sách bài viết dạng lưới Card -->
    <div class="row g-4 mb-4">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                        @if (!string.IsNullOrEmpty(item.AnhDaiDien))
                        {
                            <img src="@item.AnhDaiDien" 
                                 alt="@item.TieuDe" 
                                 class="card-img-top" 
                                 style="height: 200px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-primary bg-opacity-10 text-primary text-center py-5">
                                <i class="bi bi-journal-text fs-1"></i>
                            </div>
                        }
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-primary-subtle text-primary">
                                    @(item.DanhMuc != null ? item.DanhMuc.TenDanhMuc : "Tin tức")
                                </span>
                                <small class="text-muted"><i class="bi bi-clock me-1"></i>@item.NgayTao.ToString("dd/MM/yyyy")</small>
                            </div>
                            <h5 class="fw-bold mb-2">
                                <a asp-controller="Post" asp-action="ChiTiet" asp-route-id="@item.MaBaiViet" class="text-dark text-decoration-none">
                                    @item.TieuDe
                                </a>
                            </h5>
                            <p class="text-secondary small flex-grow-1">
                                @(string.IsNullOrEmpty(item.TomTat) ? (item.NoiDung.Length > 100 ? item.NoiDung.Substring(0, 100) + "..." : item.NoiDung) : item.TomTat)
                            </p>
                            <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                                <small class="text-muted">
                                    <i class="bi bi-person me-1"></i>@(item.TacGia != null ? item.TacGia.HoTen : "Ban Biên Tập")
                                </small>
                                <a asp-controller="Post" asp-action="ChiTiet" asp-route-id="@item.MaBaiViet" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    Đọc tiếp <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="bg-light text-muted rounded-circle d-inline-flex p-4 mb-3">
                    <i class="bi bi-journal-x fs-1"></i>
                </div>
                <h5 class="fw-bold text-dark">Không tìm thấy bài viết nào</h5>
                <p class="text-muted small">Vui lòng thử tìm kiếm với từ khóa khác hoặc bấm Đăng bài viết mới.</p>
            </div>
        }
    </div>
</div>
