@model IEnumerable<WNC15.Models.DanhMuc>
@{
    ViewData["Title"] = "Quản lý danh mục bài viết";

    int tongSoDanhMuc = Model?.Count() ?? 0;

    int tongSoBaiViet = Model?.Sum(d => d.BaiViets?.Count ?? 0) ?? 0;
}

<div class="py-3">
    <!-- Header Quản lý danh mục -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <span class="badge bg-primary px-3 py-1 mb-1">
                <i class="bi bi-tags-fill me-1"></i>Hệ thống Quản Trị Viên
            </span>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-folder2-open text-primary me-2"></i>Quản Lý Danh Mục Bài Viết
            </h2>
            <p class="text-muted small mb-0">Thêm mới, điều chỉnh tên, mô tả và quản lý các danh mục phân loại bài viết
                & tin tức</p>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <a asp-controller="AdminMember" asp-action="BangQuanTri" class="btn btn-outline-secondary fw-semibold">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
            <button type="button" class="btn btn-primary fw-semibold shadow-sm" data-bs-toggle="modal"
                data-bs-target="#modalThemDanhMuc">
                <i class="bi bi-plus-circle me-1"></i> Thêm danh mục mới
            </button>
        </div>
    </div>

    <!-- Khu vực thông báo (TempData & AJAX) -->
    <div id="categoryAlert">
        @if (TempData["SuccessMessage"] != null)

        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center"
                role="alert">
                <i class="bi bi-check-circle-fill fs-5 me-2"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)

        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center"
                role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- 2 Thẻ KPI thống kê nhanh -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-secondary small fw-semibold">Tổng số chuyên mục</span>
                    <div class="bg-primary bg-opacity-10 text-primary p-2 rounded-3">
                        <i class="bi bi-tags fs-4"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark mb-0" id="lblTongDanhMuc">@tongSoDanhMuc</h3>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-secondary small fw-semibold">Bài viết đã phân loại</span>
                    <div class="bg-success bg-opacity-10 text-success p-2 rounded-3">
                        <i class="bi bi-newspaper fs-4"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark mb-0">@tongSoBaiViet</h3>
            </div>
        </div>
    </div>

    <!-- Bảng danh sách danh mục -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-list-stars text-primary me-2"></i>Danh Sách Danh Mục Hiện Tại
            </h5>
            <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill small">
                Hiển thị: <strong>@tongSoDanhMuc</strong> chuyên mục
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="tableDanhMuc">
                <thead class="table-light text-secondary small">
                    <tr>
                        <th class="ps-4" style="width: 80px;">MÃ</th>
                        <th style="min-width: 220px;">TÊN DANH MỤC</th>
                        <th style="min-width: 300px;">MÔ TẢ</th>
                        <th class="text-center" style="width: 160px;">SỐ BÀI VIẾT</th>
                        <th class="text-end pe-4" style="width: 180px;">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())

                    {

                        foreach (var item in Model)

                        {
                            var soBai = item.BaiViets?.Count ?? 0;
                            <tr id="row-dm-@item.MaDanhMuc">
                                <td class="ps-4 fw-bold text-muted">#@item.MaDanhMuc</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 me-3 d-flex align-items-center justify-content-center"
                                            style="width: 38px; height: 38px;">
                                            <i class="bi bi-bookmark-fill"></i>
                                        </div>
                                        <div>
                                            <span class="fw-bold text-dark d-block ten-dm-text">@item.TenDanhMuc</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted small mota-dm-text">
                                        @(string.IsNullOrWhiteSpace(item.MoTa) ? "— Chưa có mô tả —" : item.MoTa)
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (soBai > 0)
                                    {
                                        <span class="badge bg-primary text-white fw-bold px-3 py-2 rounded-pill shadow-sm" style="font-size: 0.85rem;">
                                            <i class="bi bi-file-earmark-text-fill me-1"></i> @soBai bài viết
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary text-white fw-bold px-3 py-2 rounded-pill shadow-sm" style="font-size: 0.85rem;">
                                            <i class="bi bi-file-earmark me-1"></i> 0 bài viết
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-sm btn-outline-primary btn-sua-dm"
                                            data-id="@item.MaDanhMuc" data-ten="@item.TenDanhMuc" data-mota="@(item.MoTa ?? "")"
                                            title="Chỉnh sửa danh mục">
                                            <i class="bi bi-pencil-square"></i> Sửa
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger btn-xoa-dm"
                                            data-id="@item.MaDanhMuc" data-ten="@item.TenDanhMuc" data-sobaiviet="@soBai"
                                            title="Xóa danh mục">
                                            <i class="bi bi-trash"></i> Xóa
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }

                    }

                    else

                    {
                        <tr id="emptyRow">
                            <td colspan="5" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="bi bi-folder-x display-4 d-block mb-3 text-secondary"></i>
                                    <h5>Chưa có danh mục nào</h5>
                                    <p class="small mb-0">Bấm nút "Thêm danh mục mới" ở trên để bắt đầu tạo chuyên mục đầu
                                        tiên.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ==================== MODAL THÊM DANH MỤC MỚI ==================== -->
<div class="modal fade" id="modalThemDanhMuc" tabindex="-1" aria-labelledby="modalThemLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-bottom py-3 px-4">
                <h5 class="modal-title fw-bold text-dark" id="modalThemLabel">
                    <i class="bi bi-plus-circle text-primary me-2"></i>Thêm Danh Mục Mới
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formThemDanhMuc" asp-controller="AdminMember" asp-action="ThemDanhMuc" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">
                            Tên danh mục <span class="text-danger">*</span>
                        </label>
                        <input type="text" name="tenDanhMuc" id="txtTenMoi" class="form-control"
                            placeholder="Ví dụ: Công nghệ & Nghiên cứu..." required maxlength="100" />
                        <div class="form-text small">Tên chuyên mục phân loại hiển thị trên web.</div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-semibold text-secondary small">Mô tả ngắn</label>
                        <textarea name="moTa" id="txtMoTaMoi" rows="3" class="form-control"
                            placeholder="Mô tả tóm tắt nội dung của chuyên mục này..." maxlength="255"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top py-3 px-4">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-primary fw-semibold px-4 shadow-sm" id="btnSubmitThem">
                        <i class="bi bi-check2-circle me-1"></i> Lưu danh mục
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ==================== MODAL CHỈNH SỬA DANH MỤC ==================== -->
<div class="modal fade" id="modalSuaDanhMuc" tabindex="-1" aria-labelledby="modalSuaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-bottom py-3 px-4">
                <h5 class="modal-title fw-bold text-dark" id="modalSuaLabel">
                    <i class="bi bi-pencil-square text-primary me-2"></i>Chỉnh Sửa Danh Mục
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formSuaDanhMuc" asp-controller="AdminMember" asp-action="SuaDanhMuc" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="txtSuaId" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">
                            Tên danh mục <span class="text-danger">*</span>
                        </label>
                        <input type="text" name="tenDanhMuc" id="txtSuaTen" class="form-control" required
                            maxlength="100" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-semibold text-secondary small">Mô tả ngắn</label>
                        <textarea name="moTa" id="txtSuaMoTa" rows="3" class="form-control" maxlength="255"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top py-3 px-4">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-primary fw-semibold px-4 shadow-sm" id="btnSubmitSua">
                        <i class="bi bi-save me-1"></i> Cập nhật thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Hàm hiển thị thông báo
            function showMessage(type, message) {
                var icon = type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill';
                var alertHtml = `
                        <div class="alert alert-${type} alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center" role="alert">
                            <i class="bi ${icon} fs-5 me-2"></i>
                            <div>${message}</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>`;
                $('#categoryAlert').html(alertHtml);
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            // Mở Modal Sửa danh mục và điền sẵn dữ liệu
            $(document).on('click', '.btn-sua-dm', function () {
                var id = $(this).data('id');
                var ten = $(this).data('ten');
                var mota = $(this).data('mota');

                $('#txtSuaId').val(id);
                $('#txtSuaTen').val(ten);
                $('#txtSuaMoTa').val(mota);

                var modalSua = new bootstrap.Modal(document.getElementById('modalSuaDanhMuc'));
                modalSua.show();
            });

            // Xử lý gửi Form Thêm Danh Mục bằng AJAX
            $('#formThemDanhMuc').on('submit', function (e) {
                e.preventDefault();
                var $btn = $('#btnSubmitThem');
                var form = $(this);
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Đang lưu...');

                $.ajax({
                    url: form.attr('action'),
                    type: 'POST',
                    data: form.serialize(),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function (res) {
                        $btn.prop('disabled', false).html('<i class="bi bi-check2-circle me-1"></i> Lưu danh mục');
                        if (res.success) {
                            var modal = bootstrap.Modal.getInstance(document.getElementById('modalThemDanhMuc'));
                            if (modal) modal.hide();
                            form[0].reset();
                            showMessage('success', res.message);

                            // Tự động load lại sau 1s để cập nhật đầy đủ bảng
                            setTimeout(function () {
                                location.reload();
                            }, 800);
                        } else {
                            showMessage('danger', res.message);
                        }
                    },
                    error: function () {
                        $btn.prop('disabled', false).html('<i class="bi bi-check2-circle me-1"></i> Lưu danh mục');
                        showMessage('danger', 'Có lỗi xảy ra khi kết nối đến máy chủ!');
                    }
                });
            });

            // Xử lý gửi Form Sửa Danh Mục bằng AJAX
            $('#formSuaDanhMuc').on('submit', function (e) {
                e.preventDefault();
                var $btn = $('#btnSubmitSua');
                var form = $(this);
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Đang cập nhật...');

                $.ajax({
                    url: form.attr('action'),
                    type: 'POST',
                    data: form.serialize(),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function (res) {
                        $btn.prop('disabled', false).html('<i class="bi bi-save me-1"></i> Cập nhật thay đổi');
                        if (res.success) {
                            var modal = bootstrap.Modal.getInstance(document.getElementById('modalSuaDanhMuc'));
                            if (modal) modal.hide();
                            showMessage('success', res.message);

                            // Cập nhật ngay trên bảng mà không cần reload
                            var $row = $('#row-dm-' + res.id);
                            if ($row.length) {
                                $row.find('.ten-dm-text').text(res.ten);
                                $row.find('.mota-dm-text').text(res.moTa || '— Chưa có mô tả —');
                                var $btnSua = $row.find('.btn-sua-dm');
                                $btnSua.data('ten', res.ten);
                                $btnSua.data('mota', res.moTa);
                            }
                        } else {
                            showMessage('danger', res.message);
                        }
                    },
                    error: function () {
                        $btn.prop('disabled', false).html('<i class="bi bi-save me-1"></i> Cập nhật thay đổi');
                        showMessage('danger', 'Có lỗi xảy ra khi cập nhật danh mục!');
                    }
                });
            });

            // Xử lý Xóa Danh Mục với cảnh báo & AJAX
            $(document).on('click', '.btn-xoa-dm', function () {
                var id = $(this).data('id');
                var ten = $(this).data('ten');
                var soBai = parseInt($(this).data('sobaiviet') || 0);

                if (soBai > 0) {
                    alert(`Không thể xóa danh mục "${ten}" vì hiện đang có ${soBai} bài viết thuộc chuyên mục này!\nVui lòng chuyển hoặc xóa các bài viết trước.`);
                    return;
                }

                if (!confirm(`Bạn có chắc chắn muốn xóa danh mục "${ten}" khỏi hệ thống không?`)) {
                    return;
                }

                var token = $('input[name="__RequestVerificationToken"]').first().val();

                $.ajax({
                    url: '/AdminMember/XoaDanhMuc',
                    type: 'POST',
                    data: {
                        id: id,
                        __RequestVerificationToken: token
                    },
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function (res) {
                        if (res.success) {
                            showMessage('success', res.message);
                            $('#row-dm-' + id).fadeOut(400, function () {
                                $(this).remove();
                                var curCount = parseInt($('#lblTongDanhMuc').text() || 0);
                                if (curCount > 0) {
                                    $('#lblTongDanhMuc').text(curCount - 1);
                                }
                            });
                        } else {
                            showMessage('danger', res.message);
                        }
                    },
                    error: function () {
                        showMessage('danger', 'Có lỗi xảy ra khi thực hiện xóa danh mục!');
                    }
                });
            });
        });
    </script>
}
