@model IEnumerable<WNC15.Models.NguoiDung>
@{
    ViewData["Title"] = "Quản lý toàn bộ hội viên";
    var soHoSoChoDuyet = ViewBag.SoHoSoChoDuyet ?? 0;
    var tuKhoa = ViewBag.Keyword as string ?? "";
}

<div class="py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-people-fill text-primary me-2"></i>Quản Lý Hội Viên
            </h2>
            <p class="text-muted small mb-0">Theo dõi thông tin, phân quyền và quản lý trạng thái hoạt động của hội viên</p>
        </div>
        <div>
            <a asp-controller="AdminMember" asp-action="HoSoChoDuyet" class="btn btn-warning fw-semibold text-dark shadow-sm">
                <i class="bi bi-shield-lock-fill me-1"></i> Hồ sơ chờ duyệt (@soHoSoChoDuyet)
            </a>
        </div>
    </div>

    <!-- Thông báo AJAX -->
    <div id="memberAlert"></div>

    <!-- Thanh tìm kiếm và bộ lọc hội viên -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
        <form asp-controller="AdminMember" asp-action="DanhSachHoiVien" method="get">
            <div class="row g-2 align-items-center">
                <div class="col-md-9">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="keyword" value="@tuKhoa" class="form-control bg-light border-start-0" placeholder="Tìm kiếm theo họ tên, email hoặc đơn vị công tác..." />
                    </div>
                </div>
                <div class="col-md-3 d-grid">
                    <button type="submit" class="btn btn-primary fw-semibold">
                        <i class="bi bi-funnel me-1"></i> Tìm kiếm
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Bảng danh sách hội viên -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small">
                    <tr>
                        <th class="ps-4">Hội Viên</th>
                        <th>Số Điện Thoại</th>
                        <th>Cơ Quan / Đơn Vị</th>
                        <th>Chức Danh & Lĩnh Vực</th>
                        <th>Trạng Thái</th>
                        <th class="text-center pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr id="row-member-@item.MaNguoiDung">
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-person-circle fs-3 @(item.VaiTro == "quan_tri" ? "text-danger" : "text-primary")"></i>
                                        <div>
                                            <strong class="text-dark d-block">
                                                @item.HoTen
                                                @if (item.VaiTro == "quan_tri")
                                                {
                                                    <span class="badge bg-danger ms-1" style="font-size: 0.65rem;">Quản trị viên</span>
                                                }
                                            </strong>
                                            <span class="text-muted small">@item.Email</span>
                                        </div>
                                    </div>
                                </td>
                                <td>@(string.IsNullOrEmpty(item.SoDienThoai) ? "---" : item.SoDienThoai)</td>
                                <td>@(string.IsNullOrEmpty(item.DonViCongTac) ? "---" : item.DonViCongTac)</td>
                                <td>
                                    <div>@(string.IsNullOrEmpty(item.ChucDanh) ? "Chưa cập nhật" : item.ChucDanh)</div>
                                    <small class="text-muted">@(string.IsNullOrEmpty(item.LinhVuc) ? "Chưa cập nhật" : item.LinhVuc)</small>
                                </td>
                                <td id="status-member-@item.MaNguoiDung">
                                    @if (item.TrangThai == "hoat_dong")
                                    {
                                        <span class="badge bg-success-subtle text-success px-3 py-2">Đang hoạt động</span>
                                    }
                                    else if (item.TrangThai == "khoa")
                                    {
                                        <span class="badge bg-danger-subtle text-danger px-3 py-2">Đang bị khóa</span>
                                    }
                                    else if (item.TrangThai == "tu_choi")
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary px-3 py-2" title="@item.LyDoTuChoi">Bị từ chối</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning px-3 py-2">@item.TrangThai</span>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <div class="d-flex justify-content-center gap-1" id="action-member-@item.MaNguoiDung">
                                        @if (item.TrangThai == "khoa")
                                        {
                                            <form asp-controller="AdminMember" asp-action="MoKhoaTaiKhoan" method="post" class="d-inline form-toggle-member-ajax">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.MaNguoiDung" />
                                                <button type="submit" class="btn btn-outline-success btn-sm" title="Mở khóa tài khoản">
                                                    <i class="bi bi-unlock-fill"></i> Mở khóa
                                                </button>
                                            </form>
                                        }
                                        else if (item.TrangThai == "hoat_dong")
                                        {
                                            <form asp-controller="AdminMember" asp-action="KhoaTaiKhoan" method="post" class="d-inline form-toggle-member-ajax">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.MaNguoiDung" />
                                                <button type="submit" class="btn btn-outline-warning btn-sm" title="Khóa tài khoản" onclick="return confirm('Bạn có muốn tạm khóa tài khoản: @item.HoTen?');">
                                                    <i class="bi bi-lock-fill"></i> Khóa
                                                </button>
                                            </form>
                                        }

                                        <form asp-controller="AdminMember" asp-action="XoaTaiKhoan" method="post" class="d-inline form-delete-member-ajax">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.MaNguoiDung" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Xóa tài khoản" onclick="return confirm('CẢNH BÁO: Xóa vĩnh viễn hồ sơ của @item.HoTen khỏi hệ thống?');">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-people fs-1 d-block mb-2 text-secondary"></i>
                                Không tìm thấy hội viên nào phù hợp với điều kiện tìm kiếm.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            function hienThiThongBao(thanhCong, noiDung) {
                var loaiAlert = thanhCong ? 'alert-success' : 'alert-danger';
                var iconAlert = thanhCong ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill';

                var htmlAlert = `
                    <div class="alert ${loaiAlert} alert-dismissible fade show shadow-sm d-flex align-items-center mb-3" role="alert">
                        <i class="bi ${iconAlert} fs-5 me-2"></i>
                        <div>${noiDung}</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>`;

                $('#memberAlert').html(htmlAlert);
                setTimeout(function () {
                    $('#memberAlert .alert').alert('close');
                }, 4000);
            }

            // AJAX: Khóa hoặc Mở khóa tài khoản
            $(document).on('submit', '.form-toggle-member-ajax', function (e) {
                e.preventDefault();
                var form = $(this);
                var btn = form.find('button[type="submit"]');
                var originalHtml = btn.html();
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');

                $.ajax({
                    url: form.attr('action'),
                    type: 'POST',
                    data: form.serialize(),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    dataType: 'json',
                    success: function (res) {
                        if (res.success) {
                            var memberId = res.id;
                            if (res.trangThai === 'khoa') {
                                $('#status-member-' + memberId).html('<span class="badge bg-danger-subtle text-danger px-3 py-2">Đang bị khóa</span>');
                                form.attr('action', '/AdminMember/MoKhoaTaiKhoan');
                                form.find('button').removeAttr('onclick');
                                btn.prop('disabled', false).removeClass('btn-outline-warning').addClass('btn-outline-success').attr('title', 'Mở khóa tài khoản').html('<i class="bi bi-unlock-fill"></i> Mở khóa');
                            } else {
                                $('#status-member-' + memberId).html('<span class="badge bg-success-subtle text-success px-3 py-2">Đang hoạt động</span>');
                                form.attr('action', '/AdminMember/KhoaTaiKhoan');
                                form.find('button').attr('onclick', "return confirm('Bạn có muốn tạm khóa tài khoản này?');");
                                btn.prop('disabled', false).removeClass('btn-outline-success').addClass('btn-outline-warning').attr('title', 'Khóa tài khoản').html('<i class="bi bi-lock-fill"></i> Khóa');
                            }
                            hienThiThongBao(true, res.message);
                        } else {
                            btn.prop('disabled', false).html(originalHtml);
                            hienThiThongBao(false, res.message);
                        }
                    },
                    error: function () {
                        btn.prop('disabled', false).html(originalHtml);
                        hienThiThongBao(false, 'Lỗi kết nối máy chủ!');
                    }
                });
            });

            // AJAX: Xóa tài khoản
            $(document).on('submit', '.form-delete-member-ajax', function (e) {
                e.preventDefault();
                var form = $(this);

                $.ajax({
                    url: form.attr('action'),
                    type: 'POST',
                    data: form.serialize(),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    dataType: 'json',
                    success: function (res) {
                        if (res.success) {
                            $('#row-member-' + res.id).fadeOut(400, function () {
                                $(this).remove();
                            });
                            hienThiThongBao(true, res.message);
                        } else {
                            hienThiThongBao(false, res.message);
                        }
                    },
                    error: function () {
                        hienThiThongBao(false, 'Lỗi kết nối máy chủ!');
                    }
                });
            });
        });
    </script>
}
