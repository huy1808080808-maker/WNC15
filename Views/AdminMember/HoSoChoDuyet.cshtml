@model IEnumerable<WNC15.Models.NguoiDung>
@{
    ViewData["Title"] = "Xét duyệt hồ sơ gia nhập";
    var tongSo = Model?.Count() ?? 0;
}

<div class="py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-shield-check text-warning me-2"></i>Xét Duyệt Hồ Sơ Hội Viên
            </h2>
            <p class="text-muted small mb-0">Thẩm định thông tin và phê duyệt kích hoạt tài khoản hội viên mới đăng ký</p>
        </div>
        <div>
            <a asp-controller="AdminMember" asp-action="DanhSachHoiVien" class="btn btn-outline-primary fw-semibold">
                <i class="bi bi-people me-1"></i> Quản lý toàn bộ hội viên
            </a>
        </div>
    </div>

    <!-- Thông báo phản hồi nhanh AJAX -->
    <div id="ajaxAdminAlert"></div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center">
            <span class="badge bg-warning text-dark px-3 py-2" id="badgeSoHoSo">
                Hồ sơ đang chờ xử lý: <strong id="lblSoHoSo">@tongSo hồ sơ</strong>
            </span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="tableHoSoChoDuyet">
                <thead class="table-light text-secondary small">
                    <tr>
                        <th class="ps-4">Họ và Tên / Email</th>
                        <th>Số Điện Thoại</th>
                        <th>Đơn Vị Công Tác</th>
                        <th>Chức Danh & Lĩnh Vực</th>
                        <th>Thời Gian Nộp</th>
                        <th class="text-center pe-4" style="min-width: 200px;">Thao Tác Duyệt</th>
                    </tr>
                </thead>
                <tbody class="small" id="tbodyHoSo">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr id="row-member-@item.MaNguoiDung">
                                <td class="ps-4">
                                    <strong class="text-dark d-block">@item.HoTen</strong>
                                    <span class="text-muted small">@item.Email</span>
                                </td>
                                <td>@(string.IsNullOrEmpty(item.SoDienThoai) ? "---" : item.SoDienThoai)</td>
                                <td>@(string.IsNullOrEmpty(item.DonViCongTac) ? "---" : item.DonViCongTac)</td>
                                <td>
                                    <div><strong>@(string.IsNullOrEmpty(item.ChucDanh) ? "Chưa cập nhật" : item.ChucDanh)</strong></div>
                                    <small class="text-muted">@(string.IsNullOrEmpty(item.LinhVuc) ? "Chưa cập nhật" : item.LinhVuc)</small>
                                </td>
                                <td>@item.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-center pe-4">
                                    <div class="d-flex justify-content-center gap-2">
                                        <form asp-controller="AdminMember" asp-action="PheDuyet" method="post" class="d-inline form-phe-duyet-ajax">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.MaNguoiDung" />
                                            <button type="submit" class="btn btn-success btn-sm px-3 shadow-sm btn-phe-duyet-ajax" data-name="@item.HoTen">
                                                <i class="bi bi-check-lg me-1"></i> Phê duyệt
                                            </button>
                                        </form>
                                        <button type="button" class="btn btn-outline-danger btn-sm px-3" data-bs-toggle="modal" data-bs-target="#modalTuChoi" onclick="setRejectId(@item.MaNguoiDung, '@item.HoTen')">
                                            <i class="bi bi-x-lg me-1"></i> Từ chối
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr id="rowEmpty">
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                Hiện tại không có hồ sơ nào đang chờ xét duyệt.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Popup Nhập Lý do Từ chối hồ sơ -->
<div class="modal fade" id="modalTuChoi" tabindex="-1" aria-labelledby="modalTuChoiLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-danger" id="modalTuChoiLabel">
                    <i class="bi bi-x-circle me-1"></i> Từ Chối Đơn Đăng Ký
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formTuChoiAjax" asp-controller="AdminMember" asp-action="TuChoi" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <input type="hidden" id="rejectId" name="id" value="" />
                    <p class="small text-secondary mb-3">
                        Bạn đang từ chối hồ sơ của ứng viên: <strong id="rejectName" class="text-dark"></strong>.<br>
                        Vui lòng nhập lý do để ứng viên nắm rõ thông tin:
                    </p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Lý do từ chối <span class="text-danger">*</span></label>
                        <textarea name="lyDo" rows="3" class="form-control" placeholder="Ví dụ: Thiếu thông tin cơ quan công tác, lĩnh vực chuyên môn chưa phù hợp..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger px-4" id="btnConfirmTuChoi">Xác nhận từ chối</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function setRejectId(id, name) {
            document.getElementById('rejectId').value = id;
            document.getElementById('rejectName').innerText = name;
        }

        $(document).ready(function () {
            // Hàm thông báo Alert động
            function hienThiThongBaoAdmin(thanhCong, noiDung) {
                var loaiAlert = thanhCong ? 'alert-success' : 'alert-danger';
                var iconAlert = thanhCong ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill';

                var htmlAlert = `
                    <div class="alert ${loaiAlert} alert-dismissible fade show shadow-sm d-flex align-items-center mb-3" role="alert">
                        <i class="bi ${iconAlert} fs-5 me-2"></i>
                        <div>${noiDung}</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>`;

                $('#ajaxAdminAlert').html(htmlAlert);
                setTimeout(function () {
                    $('#ajaxAdminAlert .alert').alert('close');
                }, 4000);
            }

            // 1. Phê duyệt hồ sơ bằng AJAX
            $(document).on('submit', '.form-phe-duyet-ajax', function (e) {
                e.preventDefault();

                var form = $(this);
                var btn = form.find('.btn-phe-duyet-ajax');
                var tenHoiVien = btn.data('name');

                if (!confirm('Xác nhận phê duyệt kết nạp hội viên: ' + tenHoiVien + '?')) {
                    return;
                }

                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');

                $.ajax({
                    url: form.attr('action'),
                    type: 'POST',
                    data: form.serialize(),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    dataType: 'json',
                    success: function (res) {
                        if (res.success) {
                            // Làm mờ và xóa dòng hội viên khỏi bảng
                            $('#row-member-' + res.id).fadeOut(400, function () {
                                $(this).remove();
                                // Cập nhật số lượng hồ sơ
                                $('#lblSoHoSo').text(res.soHoSoChoDuyet + ' hồ sơ');

                                // Nếu đã duyệt hết hồ sơ
                                if (res.soHoSoChoDuyet === 0) {
                                    $('#tbodyHoSo').html(`
                                        <tr id="rowEmpty">
                                            <td colspan="6" class="text-center py-5 text-muted">
                                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                                Hiện tại không có hồ sơ nào đang chờ xét duyệt.
                                            </td>
                                        </tr>`);
                                }
                            });
                            hienThiThongBaoAdmin(true, res.message);
                        } else {
                            btn.prop('disabled', false).html('<i class="bi bi-check-lg me-1"></i> Phê duyệt');
                            hienThiThongBaoAdmin(false, res.message);
                        }
                    },
                    error: function () {
                        btn.prop('disabled', false).html('<i class="bi bi-check-lg me-1"></i> Phê duyệt');
                        hienThiThongBaoAdmin(false, 'Lỗi kết nối máy chủ!');
                    }
                });
            });

            // 2. Từ chối hồ sơ bằng AJAX
            $('#formTuChoiAjax').on('submit', function (e) {
                e.preventDefault();

                var form = $(this);
                var btn = $('#btnConfirmTuChoi');
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Đang xử lý...');

                $.ajax({
                    url: form.attr('action'),
                    type: 'POST',
                    data: form.serialize(),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    dataType: 'json',
                    success: function (res) {
                        // Đóng modal
                        var modalEl = document.getElementById('modalTuChoi');
                        var modalObj = bootstrap.Modal.getInstance(modalEl);
                        if (modalObj) {
                            modalObj.hide();
                        }
                        btn.prop('disabled', false).text('Xác nhận từ chối');
                        form[0].reset();

                        if (res.success) {
                            $('#row-member-' + res.id).fadeOut(400, function () {
                                $(this).remove();
                                $('#lblSoHoSo').text(res.soHoSoChoDuyet + ' hồ sơ');
                                if (res.soHoSoChoDuyet === 0) {
                                    $('#tbodyHoSo').html(`
                                        <tr id="rowEmpty">
                                            <td colspan="6" class="text-center py-5 text-muted">
                                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                                Hiện tại không có hồ sơ nào đang chờ xét duyệt.
                                            </td>
                                        </tr>`);
                                }
                            });
                            hienThiThongBaoAdmin(true, res.message);
                        } else {
                            hienThiThongBaoAdmin(false, res.message);
                        }
                    },
                    error: function () {
                        btn.prop('disabled', false).text('Xác nhận từ chối');
                        hienThiThongBaoAdmin(false, 'Lỗi kết nối máy chủ!');
                    }
                });
            });
        });
    </script>
}
