@model WNC15.Models.NguoiDung
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    var hoTen = Model != null ? Model.HoTen : "Hội viên";
    var chucDanh = Model != null && !string.IsNullOrEmpty(Model.ChucDanh) ? Model.ChucDanh : "Chuyên gia / Nhà nghiên cứu";
    var email = Model != null ? Model.Email : "Chưa cập nhật";
    var sdt = Model != null && !string.IsNullOrEmpty(Model.SoDienThoai) ? Model.SoDienThoai : "Chưa cập nhật";
    var ngayGiaNhap = Model != null ? Model.NgayTao.ToString("dd/MM/yyyy") : "2026";
    var donVi = Model != null && !string.IsNullOrEmpty(Model.DonViCongTac) ? Model.DonViCongTac : "Chưa cập nhật";
    var linhVuc = Model != null && !string.IsNullOrEmpty(Model.LinhVuc) ? Model.LinhVuc : "Khoa học & Công nghệ";
    var gioiThieu = Model != null && !string.IsNullOrEmpty(Model.GioiThieu) ? Model.GioiThieu : "Chưa có thông tin giới thiệu bản thân.";
    var soSuKien = ViewBag.SoSuKien != null ? (int)ViewBag.SoSuKien : 0;
}

<div class="row justify-content-center py-3">
    <div class="col-lg-10">
        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
            <div>
                <h3 class="fw-bold text-dark mb-1">
                    <i class="bi bi-person-vcard text-primary me-2"></i>Hồ Sơ Hội Viên
                </h3>
                <p class="text-muted small mb-0">Quản lý và cập nhật thông tin cá nhân trong hệ thống Hiệp hội</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Profile" asp-action="ChinhSua" class="btn btn-outline-primary btn-sm px-3">
                    <i class="bi bi-pencil me-1"></i> Cập nhật thông tin
                </a>
                <a asp-controller="Profile" asp-action="DoiMatKhau" class="btn btn-outline-secondary btn-sm px-3">
                    <i class="bi bi-key me-1"></i> Đổi mật khẩu
                </a>
            </div>
        </div>

        <div class="row g-4">
            <!-- Cột trái: Thẻ đại diện & Trạng thái hồ sơ -->
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 text-center p-4">
                    <div class="mb-3">
                        @if (Model != null && !string.IsNullOrEmpty(Model.AnhDaiDien))
                        {
                            <img src="@Model.AnhDaiDien" 
                                 alt="@hoTen" 
                                 class="rounded-circle shadow-sm border" 
                                 style="width: 130px; height: 130px; object-fit: cover;" 
                                 onerror="this.src='https://placehold.co/130x130?text=Avatar';" />
                        }
                        else
                        {
                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex p-4 shadow-sm">
                                <i class="bi bi-person-circle" style="font-size: 5rem;"></i>
                            </div>
                        }
                    </div>
                    <h5 class="fw-bold text-dark mb-1">@hoTen</h5>
                    <p class="text-muted small mb-3">@chucDanh</p>

                    <!-- Huy hiệu trạng thái duyệt tài khoản -->
                    <div class="mb-3">
                        @if (Model != null && Model.TrangThai == "hoat_dong")
                        {
                            <span class="badge bg-success px-3 py-2 rounded-pill">
                                <i class="bi bi-check-circle-fill me-1"></i> Hội viên chính thức
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">
                                <i class="bi bi-hourglass-split me-1"></i> Hồ sơ chờ duyệt
                            </span>
                        }
                    </div>

                    <div class="border-top pt-3 text-start small text-secondary">
                        <div class="mb-2"><i class="bi bi-envelope text-primary me-2"></i>@email</div>
                        <div class="mb-2"><i class="bi bi-telephone text-primary me-2"></i>@sdt</div>
                        <div><i class="bi bi-calendar3 text-primary me-2"></i>Gia nhập: @ngayGiaNhap</div>
                    </div>
                </div>

                <!-- Thống kê nhanh của hội viên -->
                <div class="card border-0 shadow-sm rounded-4 p-3 mt-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small text-secondary"><i class="bi bi-calendar-check text-primary me-2"></i>Sự kiện tham gia</span>
                        <a asp-controller="Profile" asp-action="SuKienCuaToi" class="badge bg-primary text-decoration-none">@soSuKien sự kiện</a>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Thông tin chi tiết chuyên môn & công tác -->
            <div class="col-md-8">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                    <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">
                        <i class="bi bi-info-circle me-1"></i> Thông Tin Chi Tiết
                    </h5>
                    
                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <label class="text-muted small d-block">Cơ quan / Đơn vị công tác</label>
                            <span class="fw-semibold text-dark">@donVi</span>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-muted small d-block">Chức danh / Chức vụ</label>
                            <span class="fw-semibold text-dark">@chucDanh</span>
                        </div>
                        <div class="col-12">
                            <label class="text-muted small d-block">Lĩnh vực hoạt động chuyên môn</label>
                            <span class="fw-semibold text-dark">@linhVuc</span>
                        </div>
                    </div>

                    <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">
                        <i class="bi bi-file-text me-1"></i> Giới Thiệu Bản Thân
                    </h5>
                    <p class="text-secondary small lh-lg mb-0" style="white-space: pre-line;">
                        @gioiThieu
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
