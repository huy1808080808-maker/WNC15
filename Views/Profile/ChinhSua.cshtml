@{
    ViewData["Title"] = "Cập nhật hồ sơ cá nhân";
}

<div class="row justify-content-center py-3">
    <div class="col-lg-8 col-md-10">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-bottom py-3 px-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h4 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-pencil-square text-primary me-2"></i>Cập Nhật Thông Tin Cá Nhân
                        </h4>
                        <small class="text-muted">Chỉnh sửa thông tin liên hệ và cơ quan công tác</small>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                <form asp-controller="Profile" asp-action="ChinhSua" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="row g-3 mb-3">
                        <div class="col-md-7">
                            <label class="form-label small fw-semibold text-secondary">Họ và tên <span class="text-danger">*</span></label>
                            <input type="text" name="fullName" class="form-control" value="NGUYỄN VĂN AN" required />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label small fw-semibold text-secondary">Số điện thoại <span class="text-danger">*</span></label>
                            <input type="tel" name="phoneNumber" class="form-control" value="0912345678" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Cơ quan / Đơn vị công tác</label>
                            <input type="text" name="address" class="form-control" value="Trường Đại học Bách Khoa" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Chức danh / Chức vụ</label>
                            <input type="text" name="jobTitle" class="form-control" value="Giảng viên / Trưởng nhóm nghiên cứu" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Ảnh đại diện mới</label>
                        <input type="file" name="avatar" class="form-control" accept="image/*" />
                        <small class="text-muted">Chấp nhận định dạng JPG, PNG dung lượng dưới 5MB</small>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-semibold text-secondary">Tóm tắt quá trình công tác & Giới thiệu bản thân</label>
                        <textarea name="introduction" rows="4" class="form-control">Có hơn 10 năm kinh nghiệm giảng dạy và chủ trì các đề tài khoa học cấp nhà nước trong lĩnh vực Thị giác máy tính và Học sâu.</textarea>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <a asp-controller="Profile" asp-action="ThongTinCaNhan" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
