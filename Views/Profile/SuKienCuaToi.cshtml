@model IEnumerable<WNC15.Models.DangKySuKien>
@{
    ViewData["Title"] = "Sự kiện của tôi";
}

<div class="py-3">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-calendar-check text-primary me-2"></i>Sự Kiện Tôi Đã Đăng Ký
            </h3>
            <p class="text-muted small mb-0">Theo dõi lịch trình các hội thảo và hoạt động chuyên môn bạn đã tham gia hoặc giữ chỗ</p>
        </div>
        <div>
            <a asp-controller="Profile" asp-action="ThongTinCaNhan" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Về Hồ sơ cá nhân
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small">
                    <tr>
                        <th class="ps-4">Tên Sự Kiện / Hội Thảo</th>
                        <th>Thời Gian Tổ Chức</th>
                        <th>Địa Điểm</th>
                        <th>Thời Điểm Đăng Ký</th>
                        <th>Tình Trạng</th>
                        <th class="text-center pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var tenSuKien = item.SuKien != null ? item.SuKien.TenSuKien : "Hội thảo chuyên môn";
                            var thoiGian = item.SuKien != null ? item.SuKien.ThoiGianToChuc.ToString("dd/MM/yyyy HH:mm") : "---";
                            var diaDiem = item.SuKien != null ? item.SuKien.DiaDiem : "---";
                            <tr>
                                <td class="ps-4">
                                    <strong class="text-dark">@tenSuKien</strong>
                                </td>
                                <td>@thoiGian</td>
                                <td>@diaDiem</td>
                                <td>@item.NgayDangKy.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (item.TrangThai == "da_diem_danh")
                                    {
                                        <span class="badge bg-primary-subtle text-primary px-3 py-2">Đã tham gia</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success px-3 py-2">Đã giữ chỗ</span>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <a asp-controller="Event" asp-action="ChiTiet" asp-route-id="@item.MaSuKien" class="btn btn-sm btn-outline-primary">
                                        Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-calendar-x fs-1 d-block mb-2 text-secondary"></i>
                                Bạn chưa đăng ký tham gia sự kiện nào.
                                <div class="mt-3">
                                    <a asp-controller="Event" asp-action="DanhSachSuKien" class="btn btn-primary btn-sm">
                                        <i class="bi bi-calendar-event me-1"></i> Khám phá các sự kiện ngay
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
