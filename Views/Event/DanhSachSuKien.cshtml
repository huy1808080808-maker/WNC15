@{
    ViewData["Title"] = "Lịch sự kiện & Hội thảo chuyên môn";
}

<div class="py-3">
    <!-- Tiêu đề & Nút Thêm sự kiện -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-calendar-event text-primary me-2"></i>Sự Kiện & Hội Thảo
            </h2>
            <p class="text-muted small mb-0">Lịch trình các hội thảo khoa học, tọa đàm kết nối và chương trình đào tạo của Hiệp hội</p>
        </div>
        <div>
            <a asp-controller="Event" asp-action="ThemSuKien" class="btn btn-primary fw-semibold shadow-sm">
                <i class="bi bi-calendar-plus me-1"></i> Tạo sự kiện mới
            </a>
        </div>
    </div>

    <!-- Thanh tìm kiếm sự kiện -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
        <form asp-controller="Event" asp-action="DanhSachSuKien" method="get">
            <div class="row g-2 align-items-center">
                <div class="col-md-9">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control bg-light border-start-0" placeholder="Tìm kiếm theo tên sự kiện hoặc địa điểm tổ chức..." />
                    </div>
                </div>
                <div class="col-md-3 d-grid">
                    <button type="submit" class="btn btn-outline-primary fw-semibold">
                        <i class="bi bi-search me-1"></i> Tìm sự kiện
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Danh sách Sự kiện dạng lưới Card -->
    <div class="row g-4 mb-4">
        <!-- Sự kiện mẫu 1 -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="bg-primary text-white p-4 text-center position-relative">
                    <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-3 px-3 py-1">Đang mở đăng ký</span>
                    <i class="bi bi-laptop fs-1 mb-2"></i>
                    <h5 class="fw-bold mb-0">Hội thảo Quốc tế về AI & Dữ liệu</h5>
                </div>
                <div class="card-body p-4 d-flex flex-column">
                    <div class="mb-3 text-secondary small">
                        <div class="mb-1"><i class="bi bi-calendar-check text-primary me-2"></i>Thời gian: <strong>15/11/2026</strong></div>
                        <div class="mb-1"><i class="bi bi-geo-alt-fill text-danger me-2"></i>Địa điểm: <strong>Hội trường A, Tòa nhà Hiệp hội</strong></div>
                        <div><i class="bi bi-people-fill text-success me-2"></i>Số chỗ còn lại: <strong>45 / 100</strong></div>
                    </div>
                    <p class="text-muted small flex-grow-1">
                        Sự kiện quy tụ các chuyên gia hàng đầu trong và ngoài nước chia sẻ về các mô hình tính toán hiệu năng cao...
                    </p>
                    <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                        <a asp-controller="Event" asp-action="ChiTiet" asp-route-id="1" class="btn btn-primary btn-sm px-3 rounded-pill">
                            <i class="bi bi-eye me-1"></i> Xem & Giữ chỗ
                        </a>
                        <a asp-controller="Event" asp-action="DanhSachDiemDanh" asp-route-id="1" class="btn btn-outline-secondary btn-sm rounded-pill" title="Dành cho Quản trị viên">
                            <i class="bi bi-card-checklist me-1"></i> Danh sách
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sự kiện mẫu 2 -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="bg-success text-white p-4 text-center position-relative">
                    <span class="badge bg-light text-dark position-absolute top-0 end-0 m-3 px-3 py-1">Sắp diễn ra</span>
                    <i class="bi bi-chat-heart fs-1 mb-2"></i>
                    <h5 class="fw-bold mb-0">Tọa đàm Kết nối Hội viên Quý 4</h5>
                </div>
                <div class="card-body p-4 d-flex flex-column">
                    <div class="mb-3 text-secondary small">
                        <div class="mb-1"><i class="bi bi-calendar-check text-primary me-2"></i>Thời gian: <strong>28/11/2026</strong></div>
                        <div class="mb-1"><i class="bi bi-geo-alt-fill text-danger me-2"></i>Địa điểm: <strong>Phòng Hội thảo trực tuyến Zoom</strong></div>
                        <div><i class="bi bi-people-fill text-success me-2"></i>Số chỗ còn lại: <strong>120 / 200</strong></div>
                    </div>
                    <p class="text-muted small flex-grow-1">
                        Gặp gỡ, giao lưu giữa các hội viên kỳ cựu và các hội viên mới gia nhập, định hướng hoạt động nhiệm kỳ mới...
                    </p>
                    <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                        <a asp-controller="Event" asp-action="ChiTiet" asp-route-id="2" class="btn btn-primary btn-sm px-3 rounded-pill">
                            <i class="bi bi-eye me-1"></i> Xem & Giữ chỗ
                        </a>
                        <a asp-controller="Event" asp-action="DanhSachDiemDanh" asp-route-id="2" class="btn btn-outline-secondary btn-sm rounded-pill" title="Dành cho Quản trị viên">
                            <i class="bi bi-card-checklist me-1"></i> Danh sách
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sự kiện mẫu 3 -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="bg-secondary text-white p-4 text-center position-relative">
                    <span class="badge bg-dark position-absolute top-0 end-0 m-3 px-3 py-1">Đã kết thúc</span>
                    <i class="bi bi-mortarboard fs-1 mb-2"></i>
                    <h5 class="fw-bold mb-0">Khóa bồi dưỡng Công bố Quốc tế</h5>
                </div>
                <div class="card-body p-4 d-flex flex-column">
                    <div class="mb-3 text-secondary small">
                        <div class="mb-1"><i class="bi bi-calendar-check text-primary me-2"></i>Thời gian: <strong>10/10/2026</strong></div>
                        <div class="mb-1"><i class="bi bi-geo-alt-fill text-danger me-2"></i>Địa điểm: <strong>Trung tâm Đào tạo Hiệp hội</strong></div>
                        <div><i class="bi bi-people-fill text-success me-2"></i>Số lượng tham dự: <strong>50 / 50 (Đầy chỗ)</strong></div>
                    </div>
                    <p class="text-muted small flex-grow-1">
                        Kỹ năng viết bài báo khoa học chuẩn ISI/Scopus và kinh nghiệm phản biện quốc tế dành cho hội viên...
                    </p>
                    <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                        <a asp-controller="Event" asp-action="ChiTiet" asp-route-id="3" class="btn btn-outline-secondary btn-sm px-3 rounded-pill">
                            <i class="bi bi-info-circle me-1"></i> Xem thông tin
                        </a>
                        <a asp-controller="Event" asp-action="DanhSachDiemDanh" asp-route-id="3" class="btn btn-outline-secondary btn-sm rounded-pill" title="Dành cho Quản trị viên">
                            <i class="bi bi-card-checklist me-1"></i> Danh sách
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
