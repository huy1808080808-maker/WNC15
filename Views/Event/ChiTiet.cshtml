@model WNC15.Models.SuKien
@{
    ViewData["Title"] = "Chi tiết sự kiện & Đăng ký tham gia";
    int maSuKien = 1;
    string tenSuKien = "Hội thảo Khoa học Quốc tế về Trí tuệ Nhân tạo & Dữ liệu";
    string diaDiem = "Hội trường A, Tòa nhà Hiệp hội";
    string thoiGian = "15/11/2026 08:30";
    int soLuongToiDa = 100;
    int soLuongDaDangKy = 0;
    string moTa = "Hội thảo quy tụ các chuyên gia hàng đầu trao đổi về ứng dụng AI trong thực tiễn.";

    if (Model != null)
    {
        maSuKien = Model.MaSuKien;
        if (!string.IsNullOrEmpty(Model.TenSuKien))
        {
            tenSuKien = Model.TenSuKien;
        }
        if (!string.IsNullOrEmpty(Model.DiaDiem))
        {
            diaDiem = Model.DiaDiem;
        }
        if (Model.ThoiGianToChuc != default)
        {
            thoiGian = Model.ThoiGianToChuc.ToString("dd/MM/yyyy HH:mm");
        }
        if (Model.SoLuongToiDa > 0)
        {
            soLuongToiDa = Model.SoLuongToiDa;
        }
        if (Model.DangKySuKiens != null)
        {
            soLuongDaDangKy = Model.DangKySuKiens.Count;
        }
        if (!string.IsNullOrEmpty(Model.MoTa))
        {
            moTa = Model.MoTa;
        }
    }
    bool daDangKy = (ViewBag.DaDangKy == true);
    int soChoConLai = soLuongToiDa - soLuongDaDangKy;
    if (soChoConLai < 0)
    {
        soChoConLai = 0;
    }
}

<div class="row justify-content-center py-3">
    <div class="col-lg-9 col-md-11">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-controller="Event" asp-action="DanhSachSuKien" class="text-decoration-none">Sự kiện</a></li>
                <li class="breadcrumb-item active" aria-current="page">Chi tiết sự kiện</li>
            </ol>
        </nav>

        <!-- Khu vực thông báo phản hồi nhanh AJAX -->
        <div id="ajaxAlertContainer"></div>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
            <div class="bg-primary text-white p-4 p-md-5">
                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-semibold mb-2">Đang mở đăng ký</span>
                <h2 class="fw-bold mb-2">@tenSuKien</h2>
                <p class="mb-0 text-white-50">Sự kiện khoa học và sinh hoạt chuyên môn của Hiệp hội</p>
            </div>

            <div class="card-body p-4 p-md-5">
                <!-- Hộp thông số thời gian & địa điểm & số chỗ tự động tính toán -->
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 text-center h-100">
                            <i class="bi bi-calendar3 text-primary fs-3 mb-2 d-block"></i>
                            <div class="small text-muted">Thời gian tổ chức</div>
                            <strong class="text-dark">@thoiGian</strong>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 text-center h-100">
                            <i class="bi bi-geo-alt-fill text-danger fs-3 mb-2 d-block"></i>
                            <div class="small text-muted">Địa điểm tổ chức</div>
                            <strong class="text-dark">@diaDiem</strong>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 text-center h-100">
                            <i class="bi bi-people-fill text-success fs-3 mb-2 d-block"></i>
                            <div class="small text-muted">Tình trạng chỗ ngồi</div>
                            <!-- CẬP NHẬT TỨC THÌ QUA AJAX -->
                            <strong class="text-success fs-5 d-block transition-all" id="boxSoChoConLai">
                                Còn @soChoConLai / @soLuongToiDa chỗ
                            </strong>
                        </div>
                    </div>
                </div>

                <!-- Nội dung sự kiện -->
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-card-text text-primary me-2"></i>Nội dung chương trình</h5>
                <div class="text-secondary lh-lg mb-4">
                    <p style="white-space: pre-line;">
                        @moTa
                    </p>
                </div>

                <!-- Khu vực nút Đăng ký tham gia (Được điều khiển qua AJAX) -->
                <div class="p-4 bg-light rounded-4 border d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <h6 class="fw-bold text-dark mb-1">Đăng ký tham dự ngay hôm nay</h6>
                        <small class="text-muted">
                            Đã có <strong id="lblSoLuongDaDangKy" class="text-primary">@soLuongDaDangKy người</strong> đăng ký tham dự sự kiện này.
                        </small>
                    </div>

                    <div id="khuVucNutDangKy" class="d-flex align-items-center gap-2">
                        @if (daDangKy)
                        {
                            <span class="badge bg-success-subtle text-success px-3 py-2 border border-success-subtle d-inline-flex align-items-center">
                                <i class="bi bi-check-circle-fill me-1"></i> Bạn đã đăng ký sự kiện này
                            </span>
                            <form id="formHuyDangKy" asp-controller="Event" asp-action="HuyDangKy" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@maSuKien" />
                                <button type="submit" class="btn btn-outline-danger px-3 py-2 btn-action-ajax">
                                    <i class="bi bi-x-circle me-1"></i> Hủy đăng ký
                                </button>
                            </form>
                        }
                        else
                        {
                            <form id="formDangKy" asp-controller="Event" asp-action="DangKyThamGia" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@maSuKien" />
                                <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold shadow-sm btn-action-ajax">
                                    <i class="bi bi-check2-circle me-1"></i> Xác nhận Đăng ký tham gia
                                </button>
                            </form>
                        }
                    </div>
                </div>

                <div class="pt-4 border-top mt-4 d-flex justify-content-between align-items-center">
                    <a asp-controller="Event" asp-action="DanhSachSuKien" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách sự kiện
                    </a>
                    <a asp-controller="Event" asp-action="DanhSachDiemDanh" asp-route-id="@maSuKien" class="btn btn-outline-primary" id="btnXemDiemDanh">
                        <i class="bi bi-card-checklist me-1"></i> Xem danh sách điểm danh (@soLuongDaDangKy)
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // XỬ LÝ KỸ THUẬT AJAX: Đăng ký & Hủy tham gia sự kiện không tải lại trang
        $(document).ready(function () {
            var maSuKien = @maSuKien;

            // Hàm hiển thị thông báo Alert động dạng Toast phía trên
            function hienThiThongBaoAjax(thanhCong, noiDung) {
                var loaiAlert = thanhCong ? 'alert-success' : 'alert-danger';
                var iconAlert = thanhCong ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill';

                var htmlAlert = `
                    <div class="alert ${loaiAlert} alert-dismissible fade show shadow-sm d-flex align-items-center mb-3" role="alert">
                        <i class="bi ${iconAlert} fs-5 me-2"></i>
                        <div>${noiDung}</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>`;

                $('#ajaxAlertContainer').html(htmlAlert);

                // Tự động biến mất sau 4 giây
                setTimeout(function () {
                    $('#ajaxAlertContainer .alert').alert('close');
                }, 4000);
            }

            // Hàm cập nhật trạng thái các nút bấm sau khi gọi AJAX thành công
            function renderNutDangKy(isRegistered, antiForgeryToken) {
                var htmlButtons = '';
                if (isRegistered) {
                    htmlButtons = `
                        <span class="badge bg-success-subtle text-success px-3 py-2 border border-success-subtle d-inline-flex align-items-center">
                            <i class="bi bi-check-circle-fill me-1"></i> Bạn đã đăng ký sự kiện này
                        </span>
                        <form id="formHuyDangKy" action="/Event/HuyDangKy" method="post" class="d-inline">
                            <input type="hidden" name="__RequestVerificationToken" value="${antiForgeryToken}" />
                            <input type="hidden" name="id" value="${maSuKien}" />
                            <button type="submit" class="btn btn-outline-danger px-3 py-2 btn-action-ajax">
                                <i class="bi bi-x-circle me-1"></i> Hủy đăng ký
                            </button>
                        </form>`;
                } else {
                    htmlButtons = `
                        <form id="formDangKy" action="/Event/DangKyThamGia" method="post" class="d-inline">
                            <input type="hidden" name="__RequestVerificationToken" value="${antiForgeryToken}" />
                            <input type="hidden" name="id" value="${maSuKien}" />
                            <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold shadow-sm btn-action-ajax">
                                <i class="bi bi-check2-circle me-1"></i> Xác nhận Đăng ký tham gia
                            </button>
                        </form>`;
                }
                $('#khuVucNutDangKy').html(htmlButtons);
            }

            // Bắt sự kiện submit form Đăng ký hoặc Hủy đăng ký bằng AJAX (sử dụng Event Delegation)
            $(document).on('submit', '#formDangKy, #formHuyDangKy', function (e) {
                e.preventDefault(); // Chặn hành vi submit mặc định làm reload trang!

                var form = $(this);
                var urlTarget = form.attr('action');
                var formData = form.serialize();
                var btnSubmit = form.find('.btn-action-ajax');
                var originalHtml = btnSubmit.html();

                // Lưu lại token bảo mật để render lại form sau khi AJAX xong
                var token = form.find('input[name="__RequestVerificationToken"]').val();

                // Hiển thị trạng thái đang xử lý trên nút bấm
                btnSubmit.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Đang xử lý...');

                // Gửi HTTP Request ngầm qua AJAX
                $.ajax({
                    url: urlTarget,
                    type: 'POST',
                    data: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest' // Header báo cho Server biết đây là AJAX
                    },
                    dataType: 'json',
                    success: function (res) {
                        if (res.success) {
                            // 1. Cập nhật số chỗ còn lại trên giao diện tức thì
                            $('#boxSoChoConLai')
                                .text('Còn ' + res.soChoConLai + ' / ' + res.soLuongToiDa + ' chỗ')
                                .hide().fadeIn(400);

                            // 2. Cập nhật số người đã đăng ký
                            $('#lblSoLuongDaDangKy').text(res.soLuongDaDangKy + ' người');

                            // 3. Cập nhật nút xem danh sách điểm danh
                            $('#btnXemDiemDanh').html('<i class="bi bi-card-checklist me-1"></i> Xem danh sách điểm danh (' + res.soLuongDaDangKy + ')');

                            // 4. Đổi trạng thái nút bấm (Đăng ký <-> Hủy đăng ký)
                            renderNutDangKy(res.isRegistered, token);

                            // 5. Hiển thị thông báo thành công
                            hienThiThongBaoAjax(true, res.message);
                        } else {
                            // Khôi phục nút bấm và báo lỗi
                            btnSubmit.prop('disabled', false).html(originalHtml);
                            hienThiThongBaoAjax(false, res.message);
                        }
                    },
                    error: function () {
                        btnSubmit.prop('disabled', false).html(originalHtml);
                        hienThiThongBaoAjax(false, 'Có lỗi kết nối đến máy chủ. Vui lòng thử lại sau!');
                    }
                });
            });
        });
    </script>
}
